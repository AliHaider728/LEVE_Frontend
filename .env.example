# Public backend origin. Leave blank to use the same-origin API proxy.
NEXT_PUBLIC_API_URL=
PORT=
HOSTNAME=

# Optional: match the backend session cookie name. Default: leva_admin_token.
ADMIN_SESSION_COOKIE_NAME=

# Server-side backend origin used by admin and local API proxies.
BACKEND_API_URL=https://leva-backend.vercel.app
